@page "/Account/Manage"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using SurveyApp.Server.Data

@attribute [Authorize]

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Личный кабинет</PageTitle>

<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

@if (isLoading)
{
    <div class="survey-section-card">
        <p class="mb-0">Загрузка профиля...</p>
    </div>
}
else
{
    <div class="survey-editor-page">
        <section class="survey-section-card">
            <div class="manage-profile-layout">
                <div class="manage-profile-photo-block">
                    @if (profile?.Photo is not null && !string.IsNullOrWhiteSpace(profile.PhotoContentType))
                    {
                        <img class="manage-profile-photo"
                             src="@GetPhotoSrc()"
                             alt="Фото профиля" />
                    }
                    else
                    {
                        <div class="manage-profile-photo manage-profile-photo-placeholder">
                            @GetInitials()
                        </div>
                    }

                    <div class="manage-profile-photo-actions">
                        <InputFile OnChange="HandlePhotoSelected"
                                   class="form-control"
                                   accept="image/*" />

                        <small class="text-muted">Максимальный размер файла: 2 МБ</small>

                        @if (profile?.Photo is not null)
                        {
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm"
                                    @onclick="OpenRemovePhotoModal">
                                Удалить фото
                            </button>
                        }
                    </div>
                </div>

                <div class="manage-profile-form-block">
                    <EditForm EditContext="editContext" OnValidSubmit="OnValidSubmitAsync" OnInvalidSubmit="OnInvalidSubmit" class="auth-form">
                        <DataAnnotationsValidator />

                        <div class="profile-form-sections">
                            <div class="profile-form-section">
                                <div class="profile-form-section-title">Личные данные</div>
                                <div class="survey-meta-grid">
                                    <div class="survey-field @(IsFieldInvalid(nameof(Input.FirstName)) ? "profile-field-invalid" : "")">
                                        <label for="firstName" class="form-label">Имя</label>
                                        <InputText @bind-Value="Input.FirstName"
                                                   id="firstName"
                                                   class="form-control"
                                                   placeholder="Введите имя"
                                                   @oninput="MarkDirty" />
                                        <ValidationMessage For="() => Input.FirstName" class="text-danger" />
                                    </div>

                                    <div class="survey-field @(IsFieldInvalid(nameof(Input.LastName)) ? "profile-field-invalid" : "")">
                                        <label for="lastName" class="form-label">Фамилия</label>
                                        <InputText @bind-Value="Input.LastName"
                                                   id="lastName"
                                                   class="form-control"
                                                   placeholder="Введите фамилию"
                                                   @oninput="MarkDirty" />
                                        <ValidationMessage For="() => Input.LastName" class="text-danger" />
                                    </div>

                                    <div class="survey-field @(IsFieldInvalid(nameof(Input.BirthDate)) ? "profile-field-invalid" : "")">
                                        <label for="birthDate" class="form-label">Дата рождения</label>
                                        <InputDate @bind-Value="Input.BirthDate"
                                                   @bind-Value:after="MarkDirty"
                                                   id="birthDate"
                                                   class="form-control" />
                                        <ValidationMessage For="() => Input.BirthDate" class="text-danger" />
                                    </div>

                                    <div class="survey-field @(IsFieldInvalid(nameof(Input.Gender)) ? "profile-field-invalid" : "")">
                                        <label for="gender" class="form-label">Пол</label>
                                        <InputSelect @bind-Value="Input.Gender"
                                                     @bind-Value:after="MarkDirty"
                                                     id="gender"
                                                     class="form-select">
                                            <option value="">Не указано</option>
                                            <option value="Мужской">Мужской</option>
                                            <option value="Женский">Женский</option>
                                        </InputSelect>
                                        <ValidationMessage For="() => Input.Gender" class="text-danger" />
                                    </div>
                                </div>
                            </div>

                            <div class="profile-form-section">
                                <div class="profile-form-section-title">Контактные данные</div>
                                <div class="survey-meta-grid">
                                    <div class="survey-field">
                                        <label for="email" class="form-label">Электронная почта</label>
                                        <input type="text"
                                               value="@email"
                                               id="email"
                                               class="form-control"
                                               disabled />
                                    </div>

                                    <div class="survey-field @(IsFieldInvalid(nameof(Input.PhoneNumber)) ? "profile-field-invalid" : "")">
                                        <label for="phone" class="form-label">Телефон</label>
                                        <InputText @bind-Value="Input.PhoneNumber"
                                                   id="phone"
                                                   class="form-control"
                                                   placeholder="+7XXXXXXXXXX"
                                                   @onfocus="EnsurePhonePrefix"
                                                   @oninput="OnPhoneInput" />
                                        <ValidationMessage For="() => Input.PhoneNumber" class="text-danger" />
                                    </div>

                                    <div class="survey-field survey-field-full @(IsFieldInvalid(nameof(Input.City)) ? "profile-field-invalid" : "")">
                                        <label for="city" class="form-label">Город</label>
                                        <InputText @bind-Value="Input.City"
                                                   id="city"
                                                   class="form-control"
                                                   placeholder="Введите город"
                                                   @oninput="MarkDirty" />
                                        <ValidationMessage For="() => Input.City" class="text-danger" />
                                    </div>
                                </div>
                            </div>

                            <div class="profile-form-section">
                                <div class="profile-form-section-title">Безопасность</div>
                                <div class="survey-meta-grid">
                                    <div class="survey-field survey-field-full">
                                        <label for="username" class="form-label">Имя пользователя</label>
                                        <input type="text"
                                               value="@username"
                                               id="username"
                                               class="form-control"
                                               disabled />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="survey-bottom-actions survey-bottom-actions-inline mt-4">
                            <div class="survey-bottom-actions-left"></div>
                            <div class="survey-bottom-actions-center">
                                <button type="submit" class="btn btn-primary survey-save-btn">
                                    Сохранить изменения
                                </button>
                            </div>
                            <div class="survey-bottom-actions-right"></div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </section>
    </div>
}

<AppModal IsOpen="@showMessageModal"
          Title="@modalTitle"
          Message="@modalMessage"
          Variant="@modalVariant"
          ConfirmText="ОК"
          OnConfirm="CloseMessageModal" />

<AppModal IsOpen="@showLeaveModal"
          Title="Несохранённые изменения"
          Message="У вас есть несохранённые изменения. Выйти без сохранения?"
          Variant="danger"
          ConfirmText="Выйти без сохранения"
          CancelText="Остаться"
          ShowCancel="true"
          OnConfirm="LeaveWithoutSaving"
          OnCancel="StayOnPage" />

<AppModal IsOpen="@showRemovePhotoModal"
          Title="Удаление фото"
          Message="Вы уверены, что хотите удалить фото профиля?"
          Variant="danger"
          ConfirmText="Удалить"
          CancelText="Отмена"
          ShowCancel="true"
          OnConfirm="ConfirmRemovePhoto"
          OnCancel="CloseRemovePhotoModal" />

@code {
    private const long MaxPhotoSize = 2 * 1024 * 1024;

    private ApplicationUser? user;
    private UserProfile? profile;
    private EditContext editContext = default!;

    private string? username;
    private string? email;
    private string? phoneNumber;

    private bool isLoading = true;
    private bool hasUnsavedChanges;
    private string? pendingNavigationUrl;

    private bool showMessageModal;
    private bool showLeaveModal;
    private bool showRemovePhotoModal;
    private string modalTitle = "Уведомление";
    private string modalMessage = string.Empty;
    private string modalVariant = "primary";

    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(Input);
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        isLoading = true;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var currentUser = authState.User;

        if (currentUser.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/Account/Login", forceLoad: true);
            return;
        }

        var userId = UserManager.GetUserId(currentUser);

        user = await UserManager.Users
            .Include(u => u.UserProfile)
            .FirstOrDefaultAsync(u => u.Id == userId);

        if (user is null)
        {
            NavigationManager.NavigateTo("/Account/Login", forceLoad: true);
            return;
        }

        username = await UserManager.GetUserNameAsync(user);
        email = await UserManager.GetEmailAsync(user);
        phoneNumber = await UserManager.GetPhoneNumberAsync(user);

        profile = user.UserProfile;

        if (profile is null)
        {
            profile = new UserProfile
            {
                UserId = user.Id
            };

            DbContext.UserProfiles.Add(profile);
            await DbContext.SaveChangesAsync();
            user.UserProfile = profile;
        }

        Input.PhoneNumber = NormalizePhone(phoneNumber);
        Input.FirstName = profile.FirstName;
        Input.LastName = profile.LastName;
        Input.BirthDate = profile.BirthDate;
        Input.Gender = NormalizeGender(profile.Gender);
        Input.City = profile.City;

        editContext = new EditContext(Input);
        hasUnsavedChanges = false;
        isLoading = false;
    }

    private async Task HandlePhotoSelected(InputFileChangeEventArgs e)
    {
        try
        {
            if (user is null || profile is null)
                return;

            var file = e.File;

            if (file.Size > MaxPhotoSize)
            {
                ShowMessage("Ошибка загрузки", "Размер фотографии не должен превышать 2 МБ.", "danger");
                return;
            }

            if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            {
                ShowMessage("Ошибка загрузки", "Можно загружать только изображения.", "danger");
                return;
            }

            using var stream = file.OpenReadStream(MaxPhotoSize);
            using var memoryStream = new MemoryStream();

            await stream.CopyToAsync(memoryStream);

            profile.Photo = memoryStream.ToArray();
            profile.PhotoContentType = file.ContentType;

            DbContext.UserProfiles.Update(profile);
            await DbContext.SaveChangesAsync();

            ShowMessage("Фото обновлено", "Фотография профиля сохранена.", "success");
        }
        catch (Exception ex)
        {
            ShowMessage("Ошибка загрузки", $"Ошибка при загрузке фотографии: {ex.Message}", "danger");
        }
    }

    private void OpenRemovePhotoModal()
    {
        showRemovePhotoModal = true;
    }

    private void CloseRemovePhotoModal()
    {
        showRemovePhotoModal = false;
    }

    private async Task ConfirmRemovePhoto()
    {
        showRemovePhotoModal = false;
        await RemovePhoto();
    }

    private async Task RemovePhoto()
    {
        try
        {
            if (user is null || profile is null)
                return;

            profile.Photo = null;
            profile.PhotoContentType = null;

            DbContext.UserProfiles.Update(profile);
            await DbContext.SaveChangesAsync();

            ShowMessage("Фото удалено", "Фотография профиля удалена.", "success");
        }
        catch (Exception ex)
        {
            ShowMessage("Ошибка удаления", $"Ошибка при удалении фотографии: {ex.Message}", "danger");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        try
        {
            if (user is null || profile is null)
                return;

            NormalizeInput();

            if (Input.PhoneNumber != phoneNumber)
            {
                var setPhoneResult = await UserManager.SetPhoneNumberAsync(user, Input.PhoneNumber);

                if (!setPhoneResult.Succeeded)
                {
                    ShowMessage("Ошибка сохранения", "Не удалось сохранить номер телефона.", "danger");
                    return;
                }

                phoneNumber = Input.PhoneNumber;
            }

            profile.FirstName = Input.FirstName;
            profile.LastName = Input.LastName;
            profile.BirthDate = Input.BirthDate;
            profile.Gender = Input.Gender;
            profile.City = Input.City;

            DbContext.UserProfiles.Update(profile);
            await DbContext.SaveChangesAsync();

            hasUnsavedChanges = false;
            ShowMessage("Профиль сохранён", "Профиль успешно обновлён.", "success");
        }
        catch (Exception ex)
        {
            ShowMessage("Ошибка сохранения", $"Ошибка при сохранении профиля: {ex.Message}", "danger");
        }
    }

    private void OnInvalidSubmit(EditContext context)
    {
        var firstError = context.GetValidationMessages().FirstOrDefault()
            ?? "Проверьте корректность заполнения полей.";

        ShowMessage("Проверьте данные", firstError, "danger");
    }

    private void NormalizeInput()
    {
        Input.PhoneNumber = NormalizePhone(Input.PhoneNumber);
        Input.FirstName = NormalizeSpaces(Input.FirstName);
        Input.LastName = NormalizeSpaces(Input.LastName);
        Input.Gender = NormalizeGender(Input.Gender);
        Input.City = NormalizeSpaces(Input.City);
    }

    private void MarkDirty()
    {
        hasUnsavedChanges = true;
    }

    private void EnsurePhonePrefix()
    {
        if (string.IsNullOrWhiteSpace(Input.PhoneNumber))
        {
            Input.PhoneNumber = "+7";
            hasUnsavedChanges = true;
        }
    }

    private void OnPhoneInput(ChangeEventArgs e)
    {
        Input.PhoneNumber = NormalizePhoneInput(e.Value?.ToString());
        hasUnsavedChanges = true;
    }

    private void OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (!hasUnsavedChanges || showLeaveModal)
            return;

        pendingNavigationUrl = context.TargetLocation;
        context.PreventNavigation();
        showLeaveModal = true;
    }

    private void StayOnPage()
    {
        pendingNavigationUrl = null;
        showLeaveModal = false;
    }

    private void LeaveWithoutSaving()
    {
        showLeaveModal = false;
        hasUnsavedChanges = false;

        if (!string.IsNullOrWhiteSpace(pendingNavigationUrl))
        {
            NavigationManager.NavigateTo(pendingNavigationUrl);
        }
    }

    private void ShowMessage(string title, string message, string variant)
    {
        modalTitle = title;
        modalMessage = message;
        modalVariant = variant;
        showMessageModal = true;
    }

    private void CloseMessageModal()
    {
        showMessageModal = false;
    }

    private bool IsFieldInvalid(string fieldName)
    {
        if (editContext is null)
            return false;

        var fieldIdentifier = new FieldIdentifier(Input, fieldName);
        return editContext.GetValidationMessages(fieldIdentifier).Any();
    }

    private static string? NormalizeSpaces(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        return Regex.Replace(value.Trim(), @"\s+", " ");
    }

    private static string? NormalizeGender(string? value)
    {
        return value is "Мужской" or "Женский" ? value : null;
    }

    private static string? NormalizePhone(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var digits = Regex.Replace(value, @"\D", "");

        if (digits.StartsWith("8") && digits.Length == 11)
            digits = "7" + digits[1..];

        if (digits.StartsWith("7") && digits.Length == 11)
            return "+" + digits;

        return value.Trim();
    }

    private static string NormalizePhoneInput(string? value)
    {
        var digits = Regex.Replace(value ?? string.Empty, @"\D", "");

        if (string.IsNullOrWhiteSpace(digits))
            return "+7";

        if (digits.StartsWith("8"))
            digits = "7" + digits[1..];

        if (!digits.StartsWith("7"))
            digits = "7" + digits;

        if (digits.Length > 11)
            digits = digits[..11];

        return "+" + digits;
    }

    private string? GetPhotoSrc()
    {
        if (profile?.Photo is null || string.IsNullOrWhiteSpace(profile.PhotoContentType))
            return null;

        return $"data:{profile.PhotoContentType};base64,{Convert.ToBase64String(profile.Photo)}";
    }

    private string GetInitials()
    {
        var first = string.IsNullOrWhiteSpace(Input.FirstName)
            ? string.Empty
            : Input.FirstName.Trim()[0].ToString().ToUpper();

        var last = string.IsNullOrWhiteSpace(Input.LastName)
            ? string.Empty
            : Input.LastName.Trim()[0].ToString().ToUpper();

        var initials = $"{first}{last}".Trim();

        return string.IsNullOrWhiteSpace(initials) ? "U" : initials;
    }

    private sealed class InputModel : IValidatableObject
    {
        [RegularExpression(@"^\+7\d{10}$", ErrorMessage = "Телефон должен быть в формате +7XXXXXXXXXX.")]
        [Display(Name = "Телефон")]
        public string? PhoneNumber { get; set; }

        [StringLength(100, ErrorMessage = "Имя не должно превышать 100 символов.")]
        [RegularExpression(@"^[А-Яа-яЁёA-Za-z\- ]+$", ErrorMessage = "Имя может содержать только буквы, пробелы и дефис.")]
        public string? FirstName { get; set; }

        [StringLength(100, ErrorMessage = "Фамилия не должна превышать 100 символов.")]
        [RegularExpression(@"^[А-Яа-яЁёA-Za-z\- ]+$", ErrorMessage = "Фамилия может содержать только буквы, пробелы и дефис.")]
        public string? LastName { get; set; }

        public DateTime? BirthDate { get; set; }

        [RegularExpression(@"^(Мужской|Женский)?$", ErrorMessage = "Выберите значение пола из списка.")]
        public string? Gender { get; set; }

        [StringLength(100, ErrorMessage = "Город не должен превышать 100 символов.")]
        [RegularExpression(@"^[А-Яа-яЁёA-Za-z\- ]+$", ErrorMessage = "Город может содержать только буквы, пробелы и дефис.")]
        public string? City { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (BirthDate.HasValue)
            {
                var today = DateTime.Today;

                if (BirthDate.Value.Date > today)
                {
                    yield return new ValidationResult(
                        "Дата рождения не может быть позже текущей даты.",
                        new[] { nameof(BirthDate) });
                }

                if (BirthDate.Value.Date < today.AddYears(-120))
                {
                    yield return new ValidationResult(
                        "Проверьте корректность даты рождения.",
                        new[] { nameof(BirthDate) });
                }
            }
        }
    }
}
