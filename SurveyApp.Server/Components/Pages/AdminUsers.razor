@page "/admin/users"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using SurveyApp.Server.DTOs.Users
@using SurveyApp.Server.Services.Interfaces
@inject IUserManagementService UserManagementService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@attribute [Authorize(Roles = "Admin")]

<PageTitle>Пользователи</PageTitle>

<div class="survey-editor-page">
    <div class="survey-page-header">
        <div>
            <h3 class="survey-page-title">Пользователи</h3>
            <p class="survey-page-subtitle">Управление ролями и просмотр активности пользователей</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (isLoading)
    {
        <section class="survey-section-card">
            <p class="mb-0">Загрузка пользователей...</p>
        </section>
    }
    else if (summary is null)
    {
        <div class="alert alert-warning">Данные пользователей недоступны.</div>
    }
    else
    {
        <section class="statistics-summary-grid users-summary-grid">
            <div class="statistics-summary-card">
                <div class="statistics-summary-label">Всего пользователей</div>
                <div class="statistics-summary-value">@summary.TotalUsers</div>
            </div>

            <div class="statistics-summary-card">
                <div class="statistics-summary-label">Администраторы</div>
                <div class="statistics-summary-value">@summary.AdminUsers</div>
            </div>

            <div class="statistics-summary-card">
                <div class="statistics-summary-label">Среднее на пользователя</div>
                <div class="statistics-summary-value">@summary.AverageCompletedSurveysPerUser.ToString("0.##")</div>
            </div>
        </section>

        <section class="survey-section-card">
            <div class="survey-section-header survey-section-header-between statistics-table-header users-table-header">
                <div>
                    <h4 class="survey-section-title">Список пользователей</h4>
                    <p class="survey-section-subtitle">Поиск, фильтрация, сортировка и управление ролями</p>
                </div>
            </div>

            <div class="users-filters-grid mb-3">
                <div class="search-input-wrap">
                    <input class="form-control search-input-with-clear"
                           placeholder="Поиск по email, имени, фамилии или городу..."
                           @bind="searchText" />

                    @if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        <button type="button"
                                class="search-clear-btn"
                                title="Очистить поиск"
                                @onclick="ClearSearch">
                            x
                        </button>
                    }
                </div>

                <div class="survey-field users-filter-field">
                    <label class="form-label">Роль</label>
                    <select class="form-select" @bind="roleFilter">
                        <option value="All">Все роли</option>
                        <option value="Admin">Администратор</option>
                        <option value="User">Пользователь</option>
                    </select>
                </div>

                <div class="survey-field users-filter-field">
                    <label class="form-label">Сортировать по</label>
                    <select class="form-select" @bind="sortBy">
                        <option value="Email">Email</option>
                        <option value="CompletedSurveys">Прохождениям</option>
                        <option value="LastSubmittedAt">Последнему прохождению</option>
                    </select>
                </div>

                <div class="survey-field users-filter-field">
                    <label class="form-label">Порядок</label>
                    <select class="form-select" @bind="sortDirection">
                        <option value="Asc">По возрастанию</option>
                        <option value="Desc">По убыванию</option>
                    </select>
                </div>
            </div>

            @if (FilteredUsers.Count == 0)
            {
                <div class="survey-empty-state">
                    <div class="survey-empty-title">Пользователи не найдены</div>
                    <div class="survey-empty-text">Попробуйте изменить поиск, фильтр роли или сортировку.</div>
                </div>
            }
            else
            {
                <div class="table-responsive users-table-wrap">
                    <table id="users-table" class="table admin-table align-middle users-table">
                        <thead>
                            <tr>
                                <th>Email <span class="users-column-resizer"></span></th>
                                <th>Имя <span class="users-column-resizer"></span></th>
                                <th>Фамилия <span class="users-column-resizer"></span></th>
                                <th>Город <span class="users-column-resizer"></span></th>
                                <th>Дата рождения <span class="users-column-resizer"></span></th>
                                <th>Роли <span class="users-column-resizer"></span></th>
                                <th>Последнее прохождение <span class="users-column-resizer"></span></th>
                                <th>Действия <span class="users-column-resizer"></span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in FilteredUsers)
                            {
                                <tr>
                                    <td class="users-text-cell" title="@Display(user.Email)">@Display(user.Email)</td>
                                    <td class="users-text-cell" title="@Display(user.FirstName)">@Display(user.FirstName)</td>
                                    <td class="users-text-cell" title="@Display(user.LastName)">@Display(user.LastName)</td>
                                    <td class="users-text-cell" title="@Display(user.City)">@Display(user.City)</td>
                                    <td>@FormatDate(user.BirthDate)</td>
                                    <td>
                                        <div class="users-role-list">
                                            @if (user.Roles.Count == 0)
                                            {
                                                <span class="users-role-badge users-role-empty">Нет ролей</span>
                                            }
                                            else
                                            {
                                                @foreach (var role in user.Roles)
                                                {
                                                    <button type="button"
                                                            class="@GetRoleBadgeClass(role)"
                                                            title="@GetRoleActionTitle(role)"
                                                            @onclick="@(() => OpenRoleChangeModal(user, role))">
                                                        @GetRoleDisplayName(role)
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td>@FormatDateTime(user.LastSubmittedAt)</td>
                                    <td>
                                        <div class="users-actions-cell">
                                            <button type="button"
                                                    class="btn btn-success btn-sm"
                                                    @onclick='@(() => OpenDetails(user.UserId))'>
                                                Статистика
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@if (pendingRoleUser is not null && pendingRole is not null && pendingNewRole is not null)
{
    <div class="survey-modal-backdrop">
        <div class="survey-modal-window survey-modal-window-md">
            <div class="survey-modal-header">
                <h5 class="mb-0">Изменение роли пользователя</h5>
                <button type="button" class="btn-close" @onclick="CloseRoleChangeModal"></button>
            </div>

            <div class="survey-modal-body">
                <p class="mb-0">
                    Вы действительно хотите изменить роль пользователя @Display(pendingRoleUser.Email)
                    на "@GetRoleDisplayName(pendingNewRole)"?
                </p>
            </div>

            <div class="survey-modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@isRoleChanging"
                        @onclick="CloseRoleChangeModal">
                    Отмена
                </button>

                <button type="button"
                        class="btn btn-primary"
                        disabled="@isRoleChanging"
                        @onclick="ConfirmRoleChange">
                    Изменить роль
                </button>
            </div>
        </div>
    </div>
}

@code {
    private UserStatisticsSummaryDto? summary;
    private List<UserListItemDto> users = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;
    private string? currentAdminUserId;

    private string searchText = string.Empty;
    private string roleFilter = "All";
    private string sortBy = "Email";
    private string sortDirection = "Asc";
    private UserListItemDto? pendingRoleUser;
    private string? pendingRole;
    private string? pendingNewRole;
    private bool isRoleChanging;

    private List<UserListItemDto> FilteredUsers
    {
        get
        {
            IEnumerable<UserListItemDto> query = users;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(u =>
                    Contains(u.Email, searchText) ||
                    Contains(u.FirstName, searchText) ||
                    Contains(u.LastName, searchText) ||
                    Contains(u.City, searchText));
            }

            if (roleFilter != "All")
            {
                query = query.Where(u => u.Roles.Contains(roleFilter));
            }

            query = sortBy switch
            {
                "CompletedSurveys" => sortDirection == "Asc"
                    ? query.OrderBy(u => u.CompletedSurveysCount).ThenBy(u => u.Email)
                    : query.OrderByDescending(u => u.CompletedSurveysCount).ThenBy(u => u.Email),
                "LastSubmittedAt" => sortDirection == "Asc"
                    ? query.OrderBy(u => u.LastSubmittedAt ?? DateTime.MaxValue).ThenBy(u => u.Email)
                    : query.OrderByDescending(u => u.LastSubmittedAt ?? DateTime.MinValue).ThenBy(u => u.Email),
                _ => sortDirection == "Asc"
                    ? query.OrderBy(u => u.Email)
                    : query.OrderByDescending(u => u.Email)
            };

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentAdminUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await LoadUsers();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading)
            await JS.InvokeVoidAsync("surveyUsersTable.initResizable", "users-table");
    }

    private async Task LoadUsers()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            summary = await UserManagementService.GetSummaryAsync();
            users = await UserManagementService.GetUsersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка при загрузке пользователей: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenRoleChangeModal(UserListItemDto user, string role)
    {
        var newRole = GetOppositeRole(role);
        if (newRole is null)
            return;

        pendingRoleUser = user;
        pendingRole = role;
        pendingNewRole = newRole;
        successMessage = null;
        errorMessage = null;
    }

    private void CloseRoleChangeModal()
    {
        if (isRoleChanging)
            return;

        pendingRoleUser = null;
        pendingRole = null;
        pendingNewRole = null;
    }

    private async Task ConfirmRoleChange()
    {
        if (pendingRoleUser is null || pendingRole is null || pendingNewRole is null)
            return;

        isRoleChanging = true;
        successMessage = null;
        errorMessage = null;

        try
        {
            var result = pendingNewRole == "Admin"
                ? await ChangeToAdmin(pendingRoleUser.UserId)
                : await ChangeToUser(pendingRoleUser.UserId);

            if (!result)
                return;

            CloseRoleChangeModalCore();
            successMessage = "Роль успешно изменена.";
            await LoadUsers();
        }
        finally
        {
            isRoleChanging = false;
        }
    }

    private async Task<bool> ChangeToAdmin(string userId)
    {
        var addAdminResult = await SetRole(userId, "Admin", true, reload: false, showSuccess: false);
        if (!addAdminResult)
            return false;

        return await SetRole(userId, "User", false, reload: false, showSuccess: false);
    }

    private async Task<bool> ChangeToUser(string userId)
    {
        var removeAdminResult = await SetRole(userId, "Admin", false, reload: false, showSuccess: false);
        if (!removeAdminResult)
            return false;

        return await SetRole(userId, "User", true, reload: false, showSuccess: false);
    }

    private async Task<bool> SetRole(string userId, string roleName, bool assign, bool reload, bool showSuccess)
    {
        try
        {
            var result = await UserManagementService.SetUserRoleAsync(
                userId,
                roleName,
                assign,
                currentAdminUserId);

            if (!result.Succeeded)
            {
                errorMessage = NormalizeRoleError(result.Message);
                return false;
            }

            if (showSuccess)
                successMessage = result.Message;

            if (reload)
                await LoadUsers();

            return true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка при изменении роли: {ex.Message}";
            return false;
        }
    }

    private void OpenDetails(string userId)
    {
        NavigationManager.NavigateTo($"/admin/users/{Uri.EscapeDataString(userId)}");
    }

    private void CloseRoleChangeModalCore()
    {
        pendingRoleUser = null;
        pendingRole = null;
        pendingNewRole = null;
    }

    private void ClearSearch()
    {
        searchText = string.Empty;
    }

    private static bool Contains(string? value, string search)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Не указано" : value;
    }

    private static string GetRoleDisplayName(string role)
    {
        return role switch
        {
            "Admin" => "Администратор",
            "User" => "Пользователь",
            _ => role
        };
    }

    private static string? GetOppositeRole(string role)
    {
        return role switch
        {
            "Admin" => "User",
            "User" => "Admin",
            _ => null
        };
    }

    private static string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "Admin" => "users-role-badge users-role-badge-button users-role-admin",
            "User" => "users-role-badge users-role-badge-button users-role-user",
            _ => "users-role-badge users-role-badge-button users-role-empty"
        };
    }

    private static string GetRoleActionTitle(string role)
    {
        return role switch
        {
            "Admin" => "Изменить роль на пользователя",
            "User" => "Изменить роль на администратора",
            _ => "Изменить роль"
        };
    }

    private static string NormalizeRoleError(string message)
    {
        return message == "Нельзя снять роль Admin у последнего администратора."
            ? "Нельзя изменить роль последнего администратора."
            : message;
    }

    private static string FormatDate(DateTime? date)
    {
        return date.HasValue ? date.Value.ToString("dd.MM.yyyy") : "Не указано";
    }

    private static string FormatDateTime(DateTime? date)
    {
        return date.HasValue ? date.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "-";
    }
}

